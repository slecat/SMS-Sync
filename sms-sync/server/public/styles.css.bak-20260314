@import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Fira+Sans:wght@400;500;600;700&display=swap');

:root {
  --bg: #fff6ee;
  --bg-grid: rgba(217, 119, 6, 0.05);
  --bg-glow-a: rgba(251, 146, 60, 0.28);
  --bg-glow-b: rgba(244, 63, 94, 0.2);
  --bg-glow-c: rgba(250, 204, 21, 0.22);
  --surface: #ffffff;
  --surface-muted: #f6f9fc;
  --surface-strong: #f0f5fb;
  --line: #d2dce9;
  --line-strong: #b8c7dc;
  --text: #0f172a;
  --text-soft: #334155;
  --text-muted: #64748b;
  --brand: #0f766e;
  --brand-strong: #115e59;
  --ok: #0f766e;
  --warn: #b45309;
  --danger: #be123c;
  --focus: #22c55e;
  --shadow-card: 0 8px 24px rgba(15, 23, 42, 0.08);
  --shadow-soft: 0 2px 10px rgba(15, 23, 42, 0.06);
}

* {
  box-sizing: border-box;
}

html,
body {
  min-height: 100%;
}

body {
  margin: 0;
  color: var(--text);
  font-family: 'Fira Sans', 'Noto Sans SC', 'Segoe UI', sans-serif;
  line-height: 1.55;
  background:
    radial-gradient(circle at 2% -30%, var(--bg-glow-a), transparent 41%),
    radial-gradient(circle at 108% 24%, var(--bg-glow-b), transparent 35%),
    radial-gradient(circle at 48% 114%, var(--bg-glow-c), transparent 47%),
    linear-gradient(142deg, transparent 0, transparent 45%, var(--bg-grid) 45%, var(--bg-grid) 46%, transparent 46%, transparent 100%),
    var(--bg);
}

.bg-grid {
  display: none;
}

h1,
h2,
h3,
p {
  margin: 0;
}

button,
input,
select {
  font: inherit;
}

button,
.btn,
.range-btn {
  cursor: pointer;
}

button:focus-visible,
input:focus-visible,
select:focus-visible,
.range-btn:focus-visible,
.btn:focus-visible {
  outline: 2px solid var(--focus);
  outline-offset: 2px;
}

.shell {
  width: min(1320px, calc(100% - 36px));
  min-height: 100vh;
  margin: 0 auto;
  padding: 22px 0 28px;
  display: grid;
  gap: 14px;
  align-content: start;
}

.shell > .view-pane {
  display: none;
}

.shell[data-view='boot'],
.shell[data-view='auth'] {
  align-content: center;
  justify-items: center;
}

.shell[data-view='boot'] #bootPanel {
  display: grid;
}

.shell[data-view='auth'] #authPanel {
  display: grid;
}

.shell[data-view='dashboard'] #dashboard {
  display: grid;
}

.boot-panel {
  width: min(520px, 100%);
  margin: 0 auto;
  padding: 22px;
  align-items: center;
}

.card {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 14px;
  box-shadow: var(--shadow-soft);
}

.chip {
  display: inline-flex;
  align-items: center;
  border-radius: 999px;
  padding: 3px 10px;
  font-size: 12px;
  font-weight: 600;
  border: 1px solid var(--line);
}

.chip-muted {
  color: var(--text-muted);
  background: var(--surface-muted);
}

.auth-panel {
  width: min(520px, 100%);
  margin: 0 auto;
  padding: 24px;
  box-shadow: var(--shadow-card);
  border-radius: 18px;
  display: grid;
  gap: 12px;
}

.auth-panel h1 {
  font-size: clamp(28px, 3vw, 36px);
  letter-spacing: 0.1px;
}

.eyebrow {
  letter-spacing: 0.13em;
  text-transform: uppercase;
  color: var(--brand-strong);
  font-size: 12px;
  font-weight: 700;
}

.subtext {
  color: var(--text-muted);
  margin-bottom: 8px;
}

.panel-note {
  color: var(--text-muted);
  font-size: 13px;
}

.alert {
  border-radius: 12px;
  padding: 10px 12px;
  border: 1px solid;
}

.alert.info {
  border-color: #bfdbfe;
  background: #eff6ff;
  color: #1e3a8a;
}

.auth-form,
.auth-actions {
  display: grid;
  gap: 12px;
}

.auth-form .btn {
  margin-top: 2px;
}

label {
  display: grid;
  gap: 6px;
  font-size: 13px;
  color: var(--text-muted);
  font-weight: 500;
}

input,
select {
  border: 1px solid var(--line);
  border-radius: 10px;
  min-height: 42px;
  padding: 10px 12px;
  background: var(--surface-muted);
  color: var(--text-soft);
}

input::placeholder {
  color: #94a3b8;
}

.dashboard {
  display: grid;
  gap: 12px;
}

.metrics {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
}

.metric {
  padding: 16px;
}

.metric-label {
  color: var(--text-muted);
  font-size: 14px;
}

.metric-value {
  margin-top: 8px;
  font-size: clamp(26px, 2vw, 32px);
  line-height: 1.15;
  font-family: 'Fira Code', ui-monospace, SFMono-Regular, Menlo, monospace;
  color: var(--brand-strong);
}

.filters,
.panel {
  padding: 14px;
}

.panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  margin-bottom: 10px;
}

.head-meta {
  display: flex;
  gap: 8px;
  align-items: center;
  flex-wrap: wrap;
}

.quick-range {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 10px;
}

.range-btn {
  border: 1px solid var(--line-strong);
  background: var(--surface);
  color: var(--text-muted);
  min-height: 32px;
  padding: 4px 10px;
  border-radius: 8px;
  font-size: 12px;
}

.range-btn:hover {
  background: var(--surface-muted);
  color: var(--text-soft);
}

.range-btn.is-active {
  background: #ecfdf5;
  border-color: #a7f3d0;
  color: #065f46;
}

.filter-grid {
  display: grid;
  gap: 10px;
  grid-template-columns: repeat(auto-fit, minmax(172px, 1fr));
  align-items: start;
}

.filter-grid > label {
  min-width: 0;
}

.workspace-grid {
  display: grid;
  gap: 10px;
  grid-template-columns: 1fr;
  align-items: start;
}

.insight-row {
  display: grid;
  gap: 10px;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  align-items: start;
}

.message-workspace {
  display: grid;
  grid-template-rows: auto auto auto minmax(0, 1fr) auto;
  height: clamp(540px, 72vh, 860px);
  min-height: 540px;
}

.message-workspace .message-table {
  min-height: 0;
}

.message-workspace .message-table table {
  min-width: 920px;
}

.table-wrap {
  overflow: auto;
  border: 1px solid var(--line);
  border-radius: 12px;
}

table {
  width: 100%;
  border-collapse: collapse;
  background: var(--surface);
}

.compact-table table {
  min-width: 520px;
}

th,
td {
  text-align: left;
  border-bottom: 1px solid var(--line);
  padding: 11px 10px;
  color: var(--text-soft);
  vertical-align: top;
}

tbody tr {
  transition: background-color 0.15s ease;
}

tbody tr:hover {
  background: var(--surface-muted);
}

th {
  color: var(--text-muted);
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.4px;
}

.device-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 8px;
}

.device-list li {
  border: 1px solid var(--line);
  background: var(--surface-muted);
  border-radius: 12px;
  padding: 10px;
  display: grid;
  gap: 3px;
}

.device-top {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  align-items: center;
}

.device-name {
  color: var(--text-soft);
  font-weight: 600;
}

.device-meta {
  color: var(--text-muted);
  font-size: 12px;
  font-family: 'Fira Code', ui-monospace, SFMono-Regular, Menlo, monospace;
}

.btn {
  border: 1px solid transparent;
  border-radius: 10px;
  min-height: 40px;
  padding: 8px 12px;
  transition: transform 0.2s ease, opacity 0.2s ease, box-shadow 0.2s ease;
}

.btn:hover {
  transform: translateY(-1px);
}

.btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.btn-primary {
  background: linear-gradient(135deg, var(--brand), var(--brand-strong));
  color: #ffffff;
  box-shadow: 0 5px 14px rgba(15, 118, 110, 0.24);
}

.btn-ghost {
  background: var(--surface);
  color: var(--text-soft);
  border-color: var(--line-strong);
}

.btn-ghost:hover {
  box-shadow: var(--shadow-soft);
}

.btn-danger {
  background: rgba(190, 18, 60, 0.08);
  color: #9f1239;
  border-color: #fecdd3;
}

@media (max-width: 1200px) {
  .metrics {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 820px) {
  .shell {
    width: min(1320px, calc(100% - 20px));
    padding: 12px 0 20px;
  }

  .auth-panel {
    padding: 18px;
  }

  .auth-form,
  .filter-grid {
    grid-template-columns: 1fr;
  }

  .metrics {
    grid-template-columns: 1fr;
  }

  .message-workspace {
    height: auto;
    min-height: 0;
  }

  .insight-row {
    grid-template-columns: 1fr;
  }
}

@media (prefers-reduced-motion: reduce) {
  * {
    animation: none !important;
    transition: none !important;
    scroll-behavior: auto !important;
  }
}
